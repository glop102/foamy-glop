# OpenFOAM writes its output straight into the case directory.
log.*
logs/
postProcessing/
processor*/
polyMesh/

# Time directories written by the solver. The `0` directory holds the initial
# and boundary conditions and is part of the case, so it stays tracked.
cases/*/[1-9]*/
cases/*/[0-9]*.[0-9]*/

# Local nix build results
result
result-*

# Python bytecode from importing report.py
__pycache__/

# What foamy-studio and an exported Allrun write into a case. The scenario
# and the case files it exported stay, so a case can be committed.
cases/*/allrun.log
cases/*/studio.json
cases/*/report.txt
cases/*/case.foam
cases/*/*.png
cases/*/runs/

# An exported case's 0/ is a copy of 0.orig made by Allrun. (Hand-written
# cases like cavity keep their 0/ tracked; tracked files are not affected.)
cases/*/0/
