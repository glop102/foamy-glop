/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict.patches;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "closetDerived"

// Face sets for the patches createPatch carves out of the walls and rack.
actions
(
    // The register boots carry the grilles' pressure loss (system/fvOptions).
    {
        name    grilles;
        type    cellSet;
        action  new;
        source  boxToCell;
        boxes
        (
            ($regX0 $regY0 $closetH) ($regX1 $regY1 $bootTop)
            ($regX0 $offY0 $closetH) ($regX1 $offY1 $bootTop)
        );
    }
    {
        name    grilles;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     grilles;
    }

    // Closet ceiling: the faces exposed when the attic was cut away, minus
    // the register opening, which stays open into the duct.
    {
        name    ceiling;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     (-0.1 -0.1 #eval{$closetH - 0.1}) (#eval{$closetW + 0.1} #eval{$closetD + 0.1} #eval{$closetH + 0.1});
    }
    {
        name    ceiling;
        type    faceSet;
        action  subset;
        source  boundaryToFace;
    }

    // The rack's top and sides; front and back faces get their own patches.
    {
        name    rackWalls;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     (#eval{$rackLeft - 0.1} $rackFrontLo #eval{$rackBottom - 0.1}) (#eval{$rackRight + 0.1} $rackBackHi #eval{$rackTop + 0.1});
    }
    {
        name    rackWalls;
        type    faceSet;
        action  subtract;
        source  boxToFace;
        boxes
        (
            ($rackLeft $rackFrontLo $rackBottom) ($rackRight $rackFrontHi $rackTop)
            ($rackLeft $rackBackLo $rackBottom) ($rackRight $rackBackHi $rackTop)
        );
    }
    {
        name    rackWalls;
        type    faceSet;
        action  subset;
        source  boundaryToFace;
    }

    // UPS: front and back faces together, as one heated wall.
    {
        name    ups;
        type    faceSet;
        action  new;
        source  boxToFace;
        boxes
        (
            ($rackLeft $rackFrontLo ${ups/bottom}) ($rackRight $rackFrontHi ${ups/top})
            ($rackLeft $rackBackLo ${ups/bottom}) ($rackRight $rackBackHi ${ups/top})
        );
    }
    {
        name    nasFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${nas/bottom}) ($rackRight $rackFrontHi ${nas/top});
    }
    {
        name    nasBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${nas/bottom}) ($rackRight $rackBackHi ${nas/top});
    }
    {
        name    gamingFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${gaming/bottom}) ($rackRight $rackFrontHi ${gaming/top});
    }
    {
        name    gamingBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${gaming/bottom}) ($rackRight $rackBackHi ${gaming/top});
    }
    {
        name    devFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${dev/bottom}) ($rackRight $rackFrontHi ${dev/top});
    }
    {
        name    devBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${dev/bottom}) ($rackRight $rackBackHi ${dev/top});
    }
    {
        name    doorGap;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${doorGap/min} ${doorGap/max};
    }
    {
        name    window;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${window/min} ${window/max};
    }
    {
        name    highVent;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${highVent/min} ${highVent/max};
    }
    {
        name    fan;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${fan/min} ${fan/max};
    }
);

// ************************************************************************* //
