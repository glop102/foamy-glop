/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict.patches;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "closetDerived"

// Face sets for the patches createPatch carves out of the walls and rack.
actions
(
    // UPS: front and back faces together, as one heated wall.
    {
        name    ups;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${ups/bottom}) ($rackRight $rackFrontHi ${ups/top});
    }
    {
        name    ups;
        type    faceSet;
        action  add;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${ups/bottom}) ($rackRight $rackBackHi ${ups/top});
    }
    {
        name    nasFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${nas/bottom}) ($rackRight $rackFrontHi ${nas/top});
    }
    {
        name    nasBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${nas/bottom}) ($rackRight $rackBackHi ${nas/top});
    }
    {
        name    gamingFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${gaming/bottom}) ($rackRight $rackFrontHi ${gaming/top});
    }
    {
        name    gamingBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${gaming/bottom}) ($rackRight $rackBackHi ${gaming/top});
    }
    {
        name    devFront;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackFrontLo ${dev/bottom}) ($rackRight $rackFrontHi ${dev/top});
    }
    {
        name    devBack;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ($rackLeft $rackBackLo ${dev/bottom}) ($rackRight $rackBackHi ${dev/top});
    }
    {
        name    doorGap;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${doorGap/min} ${doorGap/max};
    }
    {
        name    window;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${window/min} ${window/max};
    }
    {
        name    highVent;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${highVent/min} ${highVent/max};
    }
    {
        name    acVent;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${acVent/min} ${acVent/max};
    }
    {
        name    fan;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     ${fan/min} ${fan/max};
    }
);

// ************************************************************************* //
