/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "closetDerived"

vertices
(
    (0        0        0)
    ($closetW 0        0)
    ($closetW $closetD 0)
    (0        $closetD 0)
    (0        0        $closetH)
    ($closetW 0        $closetH)
    ($closetW $closetD $closetH)
    (0        $closetD $closetH)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

boundary
(
    floor
    {
        type    wall;
        faces   ((0 3 2 1));
    }

    // Filled by subsetMesh when the rack is cut out of the room.
    rackWalls
    {
        type    wall;
        faces   ();
    }
);

defaultPatch
{
    name    walls;
    type    wall;
}

