/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "closetDerived"

// The cells kept by subsetMesh: the closet minus the rack, plus the duct.
actions
(
    {
        name    air;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (-1 -1 -1) (1000 1000 $closetH);
    }
    {
        name    air;
        type    cellSet;
        action  subtract;
        source  boxToCell;
        box     ($rackLeft $rackFront $rackBottom) ($rackRight $rackBack $rackTop);
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        boxes
        (
            ($regX0 $regY0 $closetH) ($regX1 $regY1 $bootTopOverlap)
            ($regX0 $offY0 $closetH) ($regX1 $offY1 $bootTopOverlap)
        );
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  cylinderToCell;
        point1  ($registerX $registerY $ductZ);
        point2  ($registerX $officeRegisterY $ductZ);
        radius  $ductRadius;
    }
);

