/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "closetDerived"

application     buoyantSimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         8000;       // steady state: "time" is just the iteration count
deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      1;

writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;

functions
{
    // Air going into each machine: the numbers that matter.
    nasIntake
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            nasFront;
        operation       areaAverage;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
        log             false;
    }
    nasIntakeMax { $nasIntake; operation max; }
    nasExhaust { $nasIntake; name nasBack; }
    gamingIntake { $nasIntake; name gamingFront; }
    gamingIntakeMax { $gamingIntake; operation max; }
    gamingExhaust { $gamingIntake; name gamingBack; }
    devIntake { $nasIntake; name devFront; }
    devIntakeMax { $devIntake; operation max; }
    devExhaust { $devIntake; name devBack; }

    // Mass flow through each opening, kg/s, positive out of the closet.
    // A closed opening has no faces, which these treat as a warning.
    doorGapFlow  { $nasIntake; name doorGap; operation sum; fields (phi); errors warn; }
    highVentFlow { $doorGapFlow; name highVent; }
    officeRegisterFlow { $doorGapFlow; name officeRegister; }
    fanFlow      { $doorGapFlow; name fan; }

    // Heat conducted out through each wall, W.
    wallHeat
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        patches         (leftWall rightWall frontWall backWall ceiling floor window ductWalls);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   100;
        log             false;
    }

    air
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        operation       volAverage;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
        log             false;
    }
    airMax      { $air; operation max; }

    cuts
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (T U);
        interpolationScheme cell;

        surfaces
        {
            side
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict { point ($sideCutX 0 0); normal (1 0 0); }
                interpolate false;
            }
            front
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict { point (0 $frontCutY 0); normal (0 1 0); }
                interpolate false;
            }
            duct
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict { point ($ductCutX 0 0); normal (1 0 0); }
                interpolate false;
            }
            top
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict { point (0 0 $topCutZ); normal (0 0 1); }
                interpolate false;
            }
        }
    }
}

// ************************************************************************* //
