FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync           false;
writeCyclicMatch    false;

patches
(
    { name rackFront; patchInfo { type patch; } constructFrom set; set rackFront; }
    { name rackBack;  patchInfo { type patch; } constructFrom set; set rackBack;  }
    { name lowVent;   patchInfo { type patch; } constructFrom set; set lowVent;   }
    { name highVent;  patchInfo { type patch; } constructFrom set; set highVent;  }
    { name fan;       patchInfo { type patch; } constructFrom set; set fan;       }
);

