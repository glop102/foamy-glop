/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    ".*"
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    "(floor|ceiling|leftWall|rightWall|frontWall|backWall|window|rackWalls|ups|ductWalls|attic)"
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    // Air blown in by a fan arrives a little turbulent. Fixed values rather
    // than ones derived from the inflow speed, which would be zero for a
    // fan that is off.
    "(nasBack|gamingBack|devBack|doorGap)"
    {
        type            inletOutlet;
        inletValue      uniform 3e-3;
        value           $internalField;
    }
}

// ************************************************************************* //
