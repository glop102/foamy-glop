/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    "(walls|floor|rackWalls)"
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    rackBack
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.02;
        value           $internalField;
    }

    "(rackFront|lowVent|highVent|fan)"
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}

// ************************************************************************* //
