FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ".*"
    {
        type            calculated;
        value           $internalField;
    }

    "(floor|ceiling|leftWall|rightWall|frontWall|backWall|window|rackWalls|ups|ductWalls|attic)"
    {
        type            nutkWallFunction;
        value           $internalField;
    }
}

