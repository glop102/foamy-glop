/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/closetDerived"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    ".*"
    {
        type            noSlip;
    }

    "(highVent|officeRegister)"
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    doorGap
    {
        ${:doorGapU}
    }

    fan
    {
        type            flowRateOutletVelocity;
        massFlowRate    constant $fanMassFlow;
        rhoOutlet       $rhoAir;
        value           $internalField;
    }

    // Each machine pulls air in its front and blows it out its back.
    nasFront
    {
        type            flowRateOutletVelocity;
        massFlowRate    constant $nasMassFlow;
        rhoOutlet       $rhoAir;
        value           $internalField;
    }
    nasBack
    {
        type            flowRateInletVelocity;
        massFlowRate    constant $nasMassFlow;
        rhoInlet        $rhoAir;
        value           $internalField;
    }
    gamingFront
    {
        type            flowRateOutletVelocity;
        massFlowRate    constant $gamingMassFlow;
        rhoOutlet       $rhoAir;
        value           $internalField;
    }
    gamingBack
    {
        type            flowRateInletVelocity;
        massFlowRate    constant $gamingMassFlow;
        rhoInlet        $rhoAir;
        value           $internalField;
    }
    devFront
    {
        type            flowRateOutletVelocity;
        massFlowRate    constant $devMassFlow;
        rhoOutlet       $rhoAir;
        value           $internalField;
    }
    devBack
    {
        type            flowRateInletVelocity;
        massFlowRate    constant $devMassFlow;
        rhoInlet        $rhoAir;
        value           $internalField;
    }
}

// ************************************************************************* //
