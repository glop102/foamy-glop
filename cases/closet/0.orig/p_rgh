/*--------------------------------*- C++ -*----------------------------------*\
  Server closet cooling case -- see cases/closet/README.md
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/closetDerived"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    ".*"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    // Openings see the house as a large room at rest.
    "(doorGap|highVent)"
    {
        type            totalPressure;
        p0              uniform 1e5;
        value           $internalField;
    }

    acVent
    {
        ${:acVentP}
    }
}

// ************************************************************************* //
