#!/bin/sh
# Run one or more cooling scenarios:
#
#   ./Allrun                      # every scenario in scenarios/
#   ./Allrun door-vents           # just this one
#   NPROCS=16 ./Allrun exhaust-fan
#
# Each scenario runs in its own copy of the case under runs/<scenario>/, with
# scenarios/<scenario> appended to system/closetSettings. Afterwards
# report.py prints the key temperatures and writes runs/<scenario>/*.png.
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?run this inside 'nix develop'}"/bin/tools/RunFunctions

NPROCS="${NPROCS:-8}"
[ $# -gt 0 ] || set -- $(ls scenarios)

for scenario in "$@"
do
    [ -f "scenarios/$scenario" ] || {
        echo "No scenario '$scenario'. Choose from: $(ls scenarios | tr '\n' ' ')" >&2
        exit 1
    }
done

for scenario in "$@"
do
    echo "==== $scenario"
    run="runs/$scenario"
    rm -rf "$run"
    mkdir -p "$run"
    cp -r constant system "$run"
    cat "scenarios/$scenario" >> "$run/system/closetSettings"

    (
        cd "$run" || exit 1

        # Mesh: a box for the closet, the rack cut out of it, then the
        # openings and rack faces split off into their own patches.
        runApplication blockMesh
        runApplication topoSet
        runApplication subsetMesh air -patch rackWalls -overwrite
        runApplication -s patches topoSet -dict system/topoSetDict.patches
        runApplication createPatch -overwrite
        runApplication checkMesh

        # Fields go in only once the mesh is final, so the mesh tools never
        # rewrite them.
        cp -r ../../0.orig 0

        foamDictionary -entry numberOfSubdomains -set "$NPROCS" \
            system/decomposeParDict > /dev/null 2>&1
        runApplication decomposePar
        runParallel "$(getApplication)"
        grep -q "^End" "log.$(getApplication)" || {
            echo "Solver did not finish, see $run/log.$(getApplication)" >&2
            exit 1
        }
        runApplication reconstructPar -latestTime
        rm -rf processor*
    ) || exit 1

    python3 report.py "$run" || exit 1
done

if [ $# -gt 1 ]
then
    python3 report.py --compare $(printf 'runs/%s ' "$@")
fi
